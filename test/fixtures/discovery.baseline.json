{
  "version": "0.1.0",
  "devices": {
    "firewall": {
      "external_id": "ext:opnsense:firewall:main",
      "should_poll": false,
      "params": ["OPNSENSE_VERSION"],
      "features": [
        {
          "external_id": "ext:opnsense:firewall:main:cpu",
          "category": "level-sensor",
          "type": "decimal",
          "unit": "percent",
          "min": 0,
          "max": 100,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:firewall:main:memory",
          "category": "level-sensor",
          "type": "decimal",
          "unit": "percent",
          "min": 0,
          "max": 100,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:firewall:main:disk",
          "category": "level-sensor",
          "type": "decimal",
          "unit": "percent",
          "min": 0,
          "max": 100,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:firewall:main:temperature",
          "category": "device-temperature-sensor",
          "type": "decimal",
          "unit": "celsius",
          "min": 0,
          "max": 120,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:firewall:main:uptime",
          "category": "duration",
          "type": "decimal",
          "unit": "days",
          "min": 0,
          "max": 10000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:firewall:main:updates",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 10000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:firewall:main:version",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:firewall:main:vpn_peers",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 10000,
          "read_only": true,
          "has_feedback": false
        }
      ]
    },
    "gateway": {
      "external_id": "ext:opnsense:gateway:WAN_DHCP",
      "should_poll": false,
      "params": ["OPNSENSE_GATEWAY"],
      "features": [
        {
          "external_id": "ext:opnsense:gateway:WAN_DHCP:status",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:gateway:WAN_DHCP:delay",
          "category": "duration",
          "type": "decimal",
          "unit": "milliseconds",
          "min": 0,
          "max": 10000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:gateway:WAN_DHCP:loss",
          "category": "level-sensor",
          "type": "decimal",
          "unit": "percent",
          "min": 0,
          "max": 100,
          "read_only": true,
          "has_feedback": false
        }
      ]
    },
    "interface": {
      "external_id": "ext:opnsense:interface:wan",
      "should_poll": false,
      "params": ["OPNSENSE_INTERFACE"],
      "features": [
        {
          "external_id": "ext:opnsense:interface:wan:received",
          "category": "datarate",
          "type": "rate",
          "unit": "megabits-per-second",
          "min": 0,
          "max": 100000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:interface:wan:sent",
          "category": "datarate",
          "type": "rate",
          "unit": "megabits-per-second",
          "min": 0,
          "max": 100000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:interface:wan:status",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:opnsense:interface:wan:ipv4",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        }
