          "category": "switch",
          "type": "binary",
          "min": 0,
          "max": 1,
          "read_only": false,
          "has_feedback": true
        }
      ]
    },
    "host": {
      "external_id": "ext:opnsense:host:a483e7123456",
      "should_poll": false,
      "params": ["MAC", "VENDOR"],
      "features": [
        {
          "external_id": "ext:opnsense:host:a483e7123456:presence",
          "category": "presence-sensor",
          "type": "push",
          "min": 0,
          "max": 1,
          "read_only": true,
          "has_feedback": false
        }
      ]
    }
